    },
    {
      "type": "timeseries",
      "title": "Throughput por cola (mensajes confirmados/s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(rabbitmq_detailed_queue_messages_delivered_ack_total[1m]))",
          "legendFormat": "{{queue}}",
