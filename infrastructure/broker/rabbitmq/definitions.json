{
  "rabbit_version": "3.11",
  "users": [
    {
      "name": "rabbit_user",
      "password": "rabbit_password",
      "tags": "administrator"
    }
  ],
  "vhosts": [
    { "name": "/" }
  ],
  "permissions": [
    {
      "user": "rabbit_user",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "parameters": [],
  "policies": [],
  "queues": [
    {
      "name": "svc.notification.dev.customer",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "dlx.bank.events",
        "x-dead-letter-routing-key": "svc.notification.dev.customer.dlq"
      }
    },
    {
      "name": "svc.notification.dev.customer.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "exchanges": [
    {
      "name": "bank.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "dlx.bank.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "bank.events",
      "vhost": "/",
      "destination": "svc.notification.dev.customer",
      "destination_type": "queue",
      "routing_key": "customer.*",
      "arguments": {}
    },
    {
      "source": "dlx.bank.events",
      "vhost": "/",
      "destination": "svc.notification.dev.customer.dlq",
      "destination_type": "queue",
      "routing_key": "svc.notification.dev.customer.dlq",
      "arguments": {}
    }
  ]
}
