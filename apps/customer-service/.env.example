# Copy this file to `.env` and fill real values for local development.
# Keep `.env` out of version control. Example commands to generate a secret:
#  - OpenSSL (base64):
#      openssl rand -base64 32
#  - OpenSSL (hex):
#      openssl rand -hex 32
#  - /dev/urandom (base64):
#      head -c 32 /dev/urandom | base64

# JWT secret used to sign tokens (keep private)
JWT_SECRET=
# Token expiration in milliseconds (e.g., 3600000 = 1 hour)
JWT_EXPIRATION_MS=3600000
