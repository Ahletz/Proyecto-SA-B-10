# Notification & Audit Service

# PostgreSQL
NOTIF_DB_HOST=localhost
NOTIF_DB_PORT=5435
NOTIF_DB_NAME=bank_notification
NOTIF_DB_USER=notification_user
NOTIF_DB_PASSWORD=notification_password

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=rabbit_password

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@bankusac.local

# Frontend
FRONTEND_URL=http://localhost:3000

# Fase 3: Java exporta OTLP/HTTP protobuf; habilitar al usar un Collector real.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DEPLOY_ENV=dev
APP_VERSION=local
ALERT_WEBHOOK_TOKEN=
NOTIFICATION_ALERT_EMAIL=alerts@bankusac.local
NOTIFICATION_OUTBOX_BATCH_SIZE=100
NOTIFICATION_OUTBOX_INTERVAL_MS=500
