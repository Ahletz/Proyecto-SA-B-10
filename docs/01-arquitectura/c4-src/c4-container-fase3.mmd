    payment -->|"POST /transfers · consulta · cancelación · callback<br>traceparent"| pareja
    payment -->|"pruebas y fallos"| mock
    mock -->|"callback /result por el Gateway"| gateway
    servicios --> cloudsql

    servicios -. "OTLP trazas y métricas" .-> collector
    gateway -. "OTLP" .-> collector
    agent -. "logs JSON de stdout" .-> loki
    collector --> tempo
    collector --> prom
    rabbit -. "scrape" .-> prom
    ksm -. "HPA, pods" .-> prom
    grafana --> tempo
    grafana --> prom
    grafana --> loki
